# Application
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///storage.db
MAX_UPLOAD_MB=16

# Use local for development. Set to s3 for AWS S3 or MinIO.
STORAGE_BACKEND=local
STORAGE_ROOT=instance/uploads

# S3 settings (required when STORAGE_BACKEND=s3)
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
# Leave blank for AWS. For MinIO use http://localhost:9000.
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
